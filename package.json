{
  "name": "digital-twin-command-center",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node init && pnpm --filter @dtcc/web dev",
