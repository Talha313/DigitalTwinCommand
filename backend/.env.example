# ─── Core ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://dtcc:dtcc@localhost:5432/dtcc
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_HOST=http://localhost:8000
# PUBLIC_WS_HOST=wss://your-tunnel.example   # public wss:// base Twilio can reach

# ─── Auth ────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_COOKIE_SECURE=false
# Create an admin on first boot (leave blank to self-register the first user):
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ─── LLM (Anthropic direct — chat, report research/script, grading) ──────
# The live PHONE agent's LLM is Claude hosted natively by ElevenLabs and is
# configured in the ElevenLabs dashboard, NOT here.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_REPORT_MODEL=claude-opus-5
ANTHROPIC_GRADER_MODEL=claude-haiku-4-5-20251001

# ─── ElevenLabs ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=            # Professional Voice Clone — never a stock voice
ELEVENLABS_WEBHOOK_SECRET=      # HMAC secret for post-call webhooks
# In the ElevenLabs dashboard: agent LLM = Claude Haiku 4.5, TTS = the voice id
# above, input/output audio format = ulaw_8000, and enable prompt overrides.

# ─── Twilio ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164, e.g. +14155550100
TWILIO_VALIDATE_SIGNATURES=true

# ─── Avatar / lip sync ───────────────────────────────────────────────────
LIPSYNC_PROVIDER=heygen         # heygen | did
LIPSYNC_API_KEY=
HEYGEN_AVATAR_ID=
DID_SOURCE_URL=                 # public URL of Howie's photo (D-ID only)

# ─── Object storage (S3 / MinIO) ─────────────────────────────────────────
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=               # set for MinIO / non-AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=            # CDN base; else presigned URLs are returned

# ─── Web push (VAPID) ────────────────────────────────────────────────────
# Generate: uv run python -m app.scripts.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ─── Daily report ────────────────────────────────────────────────────────
REPORT_TZ=America/New_York
REPORT_CRON_HOUR=5
REPORT_CRON_MINUTE=30
REPORT_APPROVAL_REQUIRED=true
FFMPEG_BIN=ffmpeg
